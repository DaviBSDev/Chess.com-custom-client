package com.example.chesskin

import android.Manifest
import android.app.Activity
import android.content.pm.PackageManager
import android.graphics.BitmapFactory
import android.os.Build
import android.os.Bundle
import android.os.Environment
import android.webkit.CookieManager
import android.webkit.WebResourceRequest
import android.webkit.WebResourceResponse
import android.webkit.WebView
import android.webkit.WebViewClient
import android.widget.Toast
import java.io.File

/**
 * Abre o chess.com num WebView e troca APENAS as imagens das peças.
 *
 * Suas imagens ficam em:  Imagens/ChessSkin/  (/sdcard/Pictures/ChessSkin/)
 * Nomes: wp wn wb wr wq wk (brancas) e bp bn bb br bq bk (pretas),
 * com extensão .png, .webp, .jpg ou .jpeg  (ex.: wp.png).
 *
 * Arquivo ausente, vazio ou inválido => o site usa a imagem padrão dele.
 */
class MainActivity : Activity() {
    private lateinit var web: WebView
    private val pieceRe = Regex("/pieces/[^/]+/\\d+/([wb][pnbrqk])\\.(png|svg|webp)")
    private val exts = listOf("png", "webp", "jpg", "jpeg")

    // cache: lê e valida cada imagem uma vez (refaz só se o arquivo mudar)
    private class Skin(val bytes: ByteArray?, val mime: String, val stamp: Long, val len: Long)
    private val cache = java.util.concurrent.ConcurrentHashMap<String, Skin>()

    private val skinDir: File
        get() = File(Environment.getExternalStoragePublicDirectory(Environment.DIRECTORY_PICTURES), "ChessSkin")

    private val perm: String
        get() = if (Build.VERSION.SDK_INT >= 33) Manifest.permission.READ_MEDIA_IMAGES
                else Manifest.permission.READ_EXTERNAL_STORAGE

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        try { skinDir.mkdirs() } catch (_: Exception) {}

        web = RcWebView(this)
        setContentView(web)
        web.settings.javaScriptEnabled = true
        web.settings.domStorageEnabled = true
        web.settings.cacheMode = android.webkit.WebSettings.LOAD_DEFAULT
        web.setLayerType(android.view.View.LAYER_TYPE_HARDWARE, null)
        CookieManager.getInstance().setAcceptCookie(true)
        CookieManager.getInstance().setAcceptThirdPartyCookies(web, true)

        web.webViewClient = object : WebViewClient() {
            override fun shouldInterceptRequest(
                view: WebView, request: WebResourceRequest
            ): WebResourceResponse? {
                val m = pieceRe.find(request.url.toString()) ?: return null
                return try { skinResponse(m.groupValues[1]) } catch (_: Exception) { null }
            }
        }

        if (Build.VERSION.SDK_INT >= 23 && checkSelfPermission(perm) != PackageManager.PERMISSION_GRANTED) {
            requestPermissions(arrayOf(perm), 1)
        } else {
            start()
        }
    }

    override fun onRequestPermissionsResult(code: Int, perms: Array<out String>, results: IntArray) {
        // negado = tudo continua funcionando, só com as peças padrão
        start()
    }

    private fun start() {
        Toast.makeText(this, "Peças em: " + skinDir.path, Toast.LENGTH_LONG).show()
        web.loadUrl("https://www.chess.com")
    }

    /** Devolve a imagem do usuário para a peça, ou null (= usar a original do site). */
    private fun skinResponse(piece: String): WebResourceResponse? {
        val skin = loadSkin(piece)
        val bytes = skin.bytes ?: return null
        val r = WebResourceResponse(skin.mime, null, java.io.ByteArrayInputStream(bytes))
        r.responseHeaders = mapOf("Access-Control-Allow-Origin" to "*")
        return r
    }

    private fun loadSkin(piece: String): Skin {
        var found: File? = null
        for (ext in exts) {
            val f = File(skinDir, "$piece.$ext")
            if (f.isFile) { found = f; break }
        }
        val stamp = found?.lastModified() ?: 0L
        val len = found?.length() ?: 0L
        val old = cache[piece]
        if (old != null && old.stamp == stamp && old.len == len) return old

        var skin = Skin(null, "", stamp, len)
        if (found != null && len > 0L) {
            try {
                val data = found.readBytes()
                val o = BitmapFactory.Options().apply { inJustDecodeBounds = true }
                BitmapFactory.decodeByteArray(data, 0, data.size, o)
                if (o.outWidth > 0 && o.outHeight > 0) { // imagem válida
                    val mime = when (found.extension.lowercase()) {
                        "png" -> "image/png"; "webp" -> "image/webp"; else -> "image/jpeg"
                    }
                    skin = Skin(data, mime, stamp, len)
                }
            } catch (_: Exception) {}
        }
        cache[piece] = skin
        return skin
    }

    @Suppress("DEPRECATION", "OVERRIDE_DEPRECATION")
    override fun onBackPressed() {
        if (web.canGoBack()) web.goBack() else super.onBackPressed()
    }
}
